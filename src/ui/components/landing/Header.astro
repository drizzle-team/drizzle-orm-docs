---
import { Image } from "astro:assets";
import AgentSetupEntry from "@components/AgentSetupEntry.astro";
import JavaScriptIcon from "@/assets/icons/JavaScriptIcon.astro";
import TypeScriptIcon from "@/assets/icons/TypeScriptIcon.astro";
import WithDBImage from '@/assets/images/landing/WithDB.png'
import WithDBDarkImage from '@/assets/images/landing/WithDBDark.png'
import FrontImage from '@/assets/images/landing/Front.png'
import FrontImageDark from '@/assets/images/landing/FrontDark.png'
import BackImage from '@/assets/images/landing/Back.png'
import BackImageDark from '@/assets/images/landing/BackDark.png'
import WoodBorderImage from '@/assets/images/landing/WoodBorder.webp'
import LoveImage from '@/assets/images/landing/Love.png'
import CrossOutImage from "@/assets/images/landing/CrossOut.png";
import DBImageDark from "@/assets/images/landing/dbDark.svg"
import DBImage from "@/assets/images/landing/dbLight.svg"
import PlanetScaleImage from "@/assets/images/landing/planetScale.png"
import PlanetScaleDarkImage from "@/assets/images/landing/planetScale-dark.png"
import ContactProductManager from "@mdx/ContactProductManager.astro";
import sherman from "@/assets/images/team/sherman.png";
import blokh from "@/assets/images/team/blokh.png";
import bloberenober from "@/assets/images/team/bloberenober.png";

---
<div class="header_container">
  <div class="header-left">
    <div class="title">
      ORM for you to <span class="settle">settle<Image src={CrossOutImage} alt="cross-out" class="cross-out"/><span class="ship">ship ship ship</span></span>
    </div>
    <div class="ps-label">
      <span>backed by</span>
      <Image src={PlanetScaleImage} alt="planetScale" class="img_light" />
      <Image src={PlanetScaleDarkImage} alt="planetScale" class="img_dark" />
    </div>
    <div class="tags">
      <div class="tag">
        <div class="tag-icon-container">
          <div class="tag-icon js">
            <JavaScriptIcon/>
          </div>
        </div>
        <div class="tag-text">JavaScript</div>
      </div>
      <div class="tag">
        <div class="tag-icon-container">
          <div class="tag-icon ts" >
            <TypeScriptIcon/>
          </div>
        </div>
        <div class="tag-text">TypeScript</div>
      </div>
    </div>
    <div class="hero-entry-points">
      <div class="hero-actions">
        <a href="/docs/get-started" class="hero-action hero-action--start">
          Get Started <span aria-hidden="true">→</span>
        </a>
        <ContactProductManager
          name="Drizzle Team"
          role={[]}
          people={[
            { name: "Andrew Sherman", photo: sherman },
            { name: "Alex Blokh", photo: blokh },
            { name: "Dan Kochetov", photo: bloberenober },
          ]}
          email="help@drizzle.team"
        >
          <button slot="trigger" type="button" class="hero-action hero-action--partner" data-pm-trigger>
            Build with us <span aria-hidden="true">→</span>
          </button>
        </ContactProductManager>
      </div>
      <div class="agent-setup-entry">
        <AgentSetupEntry />
      </div>
    </div>
  </div>
  <div class="header-middle-container">
    <div class="header-middle">
      <div style="display: flex; flex-direction: column; justify-content: flex-start; align-items: end">
        <div style="display: flex">
          <Image src={WithDBImage} alt="with db" class="img_light" />
          <Image src={WithDBDarkImage} alt="with db" class="img_dark" />
          <Image src={FrontImage} alt="front" class="img_light" />
          <Image src={FrontImageDark} alt="front" class="img_dark" />
        </div>
        <div class="floor"/>
      </div>
      <div>
        <Image src={BackImage} alt="back" class="img_light" />
        <Image src={BackImageDark} alt="back" class="img_dark" />
        <div class="floor"/>
      </div>
    </div>
  </div>
  <div class="header-right">
    <div class="board">
      <Image src={WoodBorderImage} width="315" height="170" alt="board" loading="eager"/>
      <div id="score" class="hidden">0000</div>
      <div class="countdown hidden">
        <Image src={DBImage} class="img_light" alt="sooper-food-image" />
        <Image src={DBImageDark} class="img_dark" alt="sooper-food-image" />
        <div id="countdown">23</div>
      </div>
      <div class="game-start-screen">
        <div style="display: flex; height: 31px; align-items: flex-end; cursor: pointer">
          <div id="start-game" class="game-button"><span>Play</span></div>
        </div>
        <div style="display: flex; height: 31px; align-items: flex-end; cursor: pointer">
          <div id="change-difficulty" class="game-button"><span id="game-difficulty">Normal</span></div>
        </div>
      </div>
      <div class="team" id="gameArea">
        <canvas id="gameCanvas"></canvas>
      </div>
    </div>
    <div class="images" style="display: flex; justify-content: space-between; width: 100%">
      <div style="display: flex; justify-content: flex-start; align-items: end; min-width: 144px">
        <Image src={WithDBImage} alt="with db" class="img_light" />
        <Image src={WithDBDarkImage} alt="with db" class="img_dark" />
        <Image src={FrontImage} alt="front" class="front img_light" />
        <Image src={FrontImageDark} alt="front" class="front img_dark" />
      </div>
      <div id="right-image" style="position: relative; flex-shrink: 0; z-index: 3">
        <Image src={BackImage} alt="back" class="img_light" />
        <Image src={BackImageDark} alt="back" class="img_dark" />
        <Image src={LoveImage} alt="love" class="love" />
      </div>
    </div>
  </div>
</div>
<script is:inline data-astro-rerun>
  if (/^((?!chrome|android).)*safari/i.test(navigator.userAgent)) {
      document.querySelector('.team').classList.add('safari-team');
      document.querySelectorAll('.front').forEach((element) => {
        element.classList.add('safari-front')
      });
      document.querySelector('.love').classList.add('safari-love');
      document.querySelector('.board').classList.add('safari-board');
  }

</script>

<script src="./snake/index.ts"></script>

<style>
  .ps-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    text-transform: uppercase;
    color: #414141;
    margin-top: 2px;
  }

  html.dark .ps-label {
    color: #e1e3e6;
  }

  .ps-label img {
    height: 16px;
    width: auto;
  }

  .ps-label .img_light {
    filter: invert(0.5);
  }

  .ps-label .img_dark {
    filter: brightness(0.8);
  }

  .header_container {
    max-width: 910px;
    margin: 144px auto 0;
    width: 100%;
    display: flex;
      gap: 20px;
  }

  .header-left {
    display: flex;
    flex-direction: column;
  }

  .hero-entry-points {
    display: grid;
    gap: 24px;
    margin-top: 24px;
  }

  .agent-setup-entry {
    margin-top: 0;
  }

  .agent-setup-entry :global(.agent-entry) {
    margin: 0;
  }

  .header-right {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 70%;
  }

  .header-middle-container {
    display: none;
    width: 100%;
    max-width: 400px;
  }

  .header-middle {
      justify-content: space-between;
      width: 100%;
      max-width: 400px;
      display: none;
      margin: 0 auto;
  }

  .header-middle img {
      height: 100px;
      width: fit-content;
      object-fit: contain;
  }

  .header-right img {
    height: 130px;
    width: fit-content;
    object-fit: contain;
    flex-shrink: 0;
      z-index: 2;
  }

  .board {
      position: absolute;
      top: 20px;
      width: 315px;
      height: 170px;
      margin-right: clamp(0px, calc(30px + (100vw - 801px)), 30px);
      right: 0;
      z-index: 1;
      transition: margin-right 0.3s;
  }

  #right-image {
      transition: margin-right 0.3s;
  }

  .safari-board {
      margin-right: clamp(0px, calc(30px + (100vw - 813px)), 30px);
  }

  .board img {
      position: relative;
      width: 100%;
      height: 100%;
      object-fit: unset;
      z-index: 2;
      pointer-events: none;
  }

  .board::before {
      content: "";
      position: absolute;
      top: 4px;
      bottom: 4px;
      right: 4px;
      left: 4px;
      display: block;
      background: #f0f0f0;
      z-index: 1;
  }

  .header-right .love {
      position: absolute;
      width: 24px;
      height: 24px;
      top: 3px;
      right: 65px;
      opacity: 0;
      transition: opacity 0.3s;
  }

  #gameArea {
      position: absolute;
      top: 5px;
      left: 4px;
      width: 304px;
      height: 160px;
      font-weight: bold;
      text-shadow: 0 0 0.5px black;
      display: inline-grid;
      grid-template-columns: 0.5fr 1.5fr 2.5fr 1fr;
      grid-auto-rows: 1fr;
      border-bottom: 1.5px solid black;
      border-left: 1.5px solid black;
      border-radius: 0;
      align-self: center;
      z-index: 1;
  }

  .game-start-screen {
      position: absolute;
      z-index: 2;
      top: 60px;
      left: 6px;
      bottom: 6px;
      right: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-weight: 600;
      font-family: FirstTimeWriting;
      text-shadow: 0.2px 0 0 #000, -0.2px 0 0 #000, 0 0.2px 0 #000, 0 -0.2px 0 #000;
      color: #000
  }

  .board-moved {
      margin-right: clamp(0px, calc(30px + (100vw - 801px)), 8px);
  }

  .right-image-moved {
      margin-right: -70px;
  }

  #score {
      position: absolute;
      font-size: 20px;
      font-weight: 700;
      top: -29px;
      font-family: FirstTimeWriting;
      text-shadow: 0.4px 0 0 #222, -0.4px 0 0 #222, 0 0.4px 0 #222, 0 -0.4px 0 #222;
  }

  html.dark #score {
      text-shadow: 0.4px 0 0 #e2e8f0, -0.4px 0 0 #e2e8f0, 0 0.4px 0 #e2e8f0, 0 -0.4px 0 #e2e8f0;
  }

  .hidden {
      opacity: 0 !important;
      pointer-events: none;
      cursor: default;
  }

  .countdown {
      position: absolute;
      top: -29px;
      right: 0;
      font-family: FirstTimeWriting;
      font-size: 20px;
      font-weight: 700;
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      text-shadow: 0.4px 0 0 #222, -0.4px 0 0 #222, 0 0.4px 0 #222, 0 -0.4px 0 #222;
      gap: 4px
  }

  html.dark .countdown {
      text-shadow: 0.4px 0 0 #e2e8f0, -0.4px 0 0 #e2e8f0, 0 0.4px 0 #e2e8f0, 0 -0.4px 0 #e2e8f0;
  }

  .countdown img{
      width: 24px;
      height: 24px;
  }

  .game-button {
      border: 1px solid #000;
      border-radius: 6px;
      padding-bottom: 2px;
      background: #c5c5c5;
      font-size: 14px;
      width: 90px;
  }

  .game-button:hover {
      padding-bottom: 4px;
  }

  .game-button:hover span {
      box-shadow: 0 4px 3px -4px black;
  }

  .game-button:active {
      padding-bottom: 0px;
  }

  .game-button:active span {
      box-shadow: inset 0 4px 3px -4px black;
  }

  .game-button span {
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #000;
      margin: -1px;
      height: 27px;
      flex-shrink: 0;
      border-radius: 6px;
      background: white;
      text-align: center;
      user-select: none;
  }

  .img_light {
      display: block;
  }

  .img_dark {
      display: none;
  }

  html.dark .img_dark {
      display: block;
  }

  html.dark .img_light {
      display: none;
  }

  .hero-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    max-width: 400px;
    margin-top: 0;
  }

  .hero-actions .hero-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 48px;
    min-height: 48px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: 3px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .hero-actions .hero-action--start {
    background: #c5f74f;
    color: #111;
  }

  .hero-actions .hero-action--start:hover {
    background: #b5e63f;
  }

  .hero-actions .hero-action--partner {
    background: #282b3b;
    color: #fff;
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-actions .hero-action--partner:hover {
    opacity: 0.85;
  }

  html.dark .hero-actions .hero-action--partner {
    background: #e2e8f0;
    color: #282828;
  }

  @media (max-width: 599px) {
    .hero-actions .hero-action {
      height: 46px;
      min-height: 46px;
      padding: 0 16px;
      font-size: 14px;
    }
  }

  .settle {
      position: relative;
      display: inline-block;
  }

  .settle .cross-out {
      position: absolute;
      top: 6px;
      right: 10px;
      left: 0;
      width: 95%;
      height: 75%;
      display: block;
  }

  .settle .ship {
      position: absolute;
      font-family: FirstTimeWriting;
      font-weight: 600;
      bottom: calc(100% - 10px);
      left: 50%;
      font-size: 30px;
      color: #3e7ff0;
      text-shadow: 0.5px 0 0 #3e7ff0, -0.5px 0 0 #3e7ff0, 0 0.5px 0 #3e7ff0, 0 -0.5px 0 #3e7ff0;
      transform: translateX(-50%) rotate(-4deg);
  }



  .tags {
    margin-top: 12px;
    display: flex;
    gap: 8px;
  }

  .tag {
    display: flex;
    align-items: center;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid rgba(33,39,46,.12);
    background-color: hsla(210,7%,95%,.27);
  }

  .tag svg {
      width: 16px;
      height: 16px;
      margin-right: 6px;
  }

  .tag-icon-container {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tag-icon {
    width: 16px;
    height: 16px;
    border-radius: 2px;
    overflow: hidden;
    color: #909090;
  }

  html.dark .tag {
      background-color: #1c1c1c;
  }

  html.dark .tag .ts {
      color: #3178C6;
  }

  html.dark .tag .js {
      color: #F7DF1E;
  }

  html.dark .tag-text {
      color: #e1e3e6;
  }

  .tag-text {
    padding: 0 8px 0 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #4b5563;
  }

  .title {
    font-size: 40px;
    font-weight: 700;
    line-height: 48px;
      white-space: nowrap;
  }

  .floor {
      display: none;
      width: 100%;
      background: black;
      height: 2px;
      border-radius: 3px;
      margin-top: -1px;
      position: relative;
      z-index: 2;
  }

  html.dark .floor {
      height: 3px;
      border: 0.5px solid #e4e4e4;
      margin-top: -1px;
  }


  @media (max-width: 1024px) {
      .board-moved {
          margin-right: clamp(0px, calc(30px + (100vw - 801px)), 30px);
      }

      .right-image-moved {
          margin-right: 0px;
      }
  }


  @media (max-width: 900px) {
      .board {
          transition: none;
      }
      #right-image {
          transition: none;
      }
      .front {
          margin-left: calc(900px - 100vw);
      }
  }

  @media (max-width: 803px) {
      .front {
          margin-left: clamp(0px, calc(97px + (100vw - 803px)), 97px);
      }

      .header-right .love {
          opacity: 1;
      }
  }

  @media (max-width: 809px) {
      .safari-front {
          margin-left: clamp(0px, calc(90px + (100vw - 809px)), 90px);
      }

      .header-right .safari-love {
          opacity: 1;
      }
  }

  @media (max-width: 783px) {
      .header-right {
          display: none;
          margin-top: 64px;
      }

      .floor {
          display: block;
      }

      .header-middle {
          width: 100%;
          display: flex;
          align-self: center;
      }

      .header-middle-container {
          display: block;
      }

      .header_container {
          flex-direction: column;
          margin: 32px auto 0;
          align-items: center;
          gap: 24px;
      }

      .header-left {
          max-width: 400px;
          width: 100%;
      }

      .hero-actions {
          width: 100%;
          margin-top: 0;
      }


      .tag-text {
          font-size: 12px;
      }

      .title {
          font-size: 26px;
          line-height: 30px;
      }

      .settle .ship {
          bottom: calc(100% - 5px);
          left: 50%;
          font-size: 20px;
          color: #3e7ff0;
          text-shadow: 0.5px 0.5px 0.3px #3e7ff0;
      }
  }
  @media (min-width: 600px) and (max-width: 783px) {
    .hero-entry-points {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 24px;
    }

    .agent-setup-entry,
    .hero-actions {
      margin-top: 0;
    }

    .header-left,
    .header-middle-container {
      max-width: 640px;
    }

    .agent-setup-entry,
    .hero-actions,
    .header-middle {
      max-width: none;
    }

    .title {
      font-size: 36px;
      line-height: 44px;
    }

    .settle .ship {
      font-size: 28px;
    }

    .tag-text {
      font-size: 14px;
    }

    .header-middle img {
      height: 130px;
    }
  }
</style>
