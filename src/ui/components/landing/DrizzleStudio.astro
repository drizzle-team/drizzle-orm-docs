---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { studioIcons as icons, type StudioIconName } from '@/data/studio-icons';
import LocalLight from '@/assets/images/drizzle-studio-local-light.webp';
import LocalDark from '@/assets/images/drizzle-studio-local-dark.webp';
import GatewayLight from '@/assets/images/drizzle-gateway-light.webp';
import GatewayDark from '@/assets/images/drizzle-gateway-dark.webp';
import GatewayRailway from '@/assets/images/drizzle-gateway-railway.webp';
import ExtensionLight from '@/assets/images/drizzle-studio-extension-2-light.webp';
import ExtensionDark from '@/assets/images/drizzle-studio-extension-2-dark.webp';
import StudioInTursoLight from '@/assets/images/drizzle-studio-in-turso-light.webp';
import StudioInTursoDark from '@/assets/images/drizzle-studio-in-turso-dark.webp';

type Tab = {
  id: StudioIconName;
  label: string;
  alt: string;
  /** one entry per screenshot shown side by side; `dark` is optional */
  shots: { light: ImageMetadata; dark?: ImageMetadata }[];
  /** small screenshot floated over the bottom right corner of the panel */
  inset?: ImageMetadata;
  insetAlt?: string;
  /** scale the shot up inside the frame, e.g. 1.15 for 115% */
  zoom?: number;
  /** which part of the shot stays in frame when zoomed */
  position?: string;
  /** fills the frame behind a shot that doesn't reach the bottom, so the
      screenshot blends into the fade instead of ending on a hard edge */
  background?: { light: string; dark?: string };
};

const tabs: Tab[] = [
  {
    id: 'local',
    label: 'Local Studio',
    alt: 'drizzle-kit studio running on a local database',
    shots: [{ light: LocalLight, dark: LocalDark }],
    // this shot is shorter than the frame — match its own bottom edge
    background: { light: '#FAFAFC', dark: '#1E1F1C' },
  },
  {
    id: 'gateway',
    label: 'Gateway',
    alt: 'Drizzle Gateway self-hosted in your own infrastructure',
    shots: [{ light: GatewayLight, dark: GatewayDark }],
    inset: GatewayRailway,
    insetAlt: 'Deploying Drizzle Gateway from the Railway template',
    // zoom: 1.18,
    // position: 'bottom',
  },
  {
    id: 'extension',
    label: 'Chrome extension',
    alt: 'Drizzle Studio inside a vendor console',
    shots: [{ light: ExtensionLight, dark: ExtensionDark }],
  },
  {
    id: 'component',
    label: 'Component',
    alt: 'Drizzle Studio embedded as a web component',
    shots: [{ light: StudioInTursoLight, dark: StudioInTursoDark }],
  },
];

// both variants are resolved here, but only the one the theme applies is ever
// fetched — an unused custom property never resolves its url()
const shotUrls = await Promise.all(
  tabs.map((tab) =>
    Promise.all(
      tab.shots.map(async (shot) => ({
        light: (await getImage({ src: shot.light, width: 1600, format: 'webp' })).src,
        dark: shot.dark
          ? (await getImage({ src: shot.dark, width: 1600, format: 'webp' })).src
          : undefined,
      })),
    ),
  ),
);
---

<div class="container">
  <div class="text_container">
    <div class="title">Drizzle Studio</div>
    <p class="description">We didn't want to build a database browser</p>
    <p class="punchline">Can't believe this either</p>
  </div>
  <div role="tablist" class="custom-pagination" aria-label="Drizzle Studio versions">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`studio-tab-${tab.id}`}
          aria-controls={`studio-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-slide-index={i}
          class="pagination-item"
        >
          <div class="icon-flex">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={icons[tab.id]} />
            </svg>
          </div>
          <div>{tab.label}</div>
          <div class="underline">
            <div class="underline-inner" />
          </div>
        </button>
      ))
    }
  </div>
  <div class="image_container">
    <div class="panels">
    {
      tabs.map((tab, i) => (
        <div
          role="tabpanel"
          id={`studio-panel-${tab.id}`}
          aria-labelledby={`studio-tab-${tab.id}`}
          data-slide-index={i}
          class:list={['panel', i === 0 && 'is-active']}
          style={{
            '--panel-bg': tab.background?.light,
            '--panel-bg-dark': tab.background?.dark ?? tab.background?.light,
          }}
        >
          {shotUrls[i].map((shot) => (
            <div
              class="image"
              role="img"
              aria-label={tab.alt}
              style={`--shot-light: url(${shot.light}); --shot-dark: url(${shot.dark ?? shot.light}); background-size: ${
                tab.zoom ? `${Math.round(tab.zoom * 100)}% auto` : 'contain'
              }; background-position: ${tab.position ?? 'top center'};`}
            />
          ))}
          {tab.inset && (
            <Image class="panel__inset" src={tab.inset} alt={tab.insetAlt ?? ''} width={620} />
          )}
        </div>
      ))
    }
    </div>
  </div>
  <div class="buttons">
    <a class="button" href="/drizzle-studio/overview"> Explore Studio </a>
    <a class="button_accent" href="https://demo.drizzle.studio"> Live demo </a>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const tablist = document.querySelector<HTMLElement>('.custom-pagination');
    const container = tablist?.closest('.container');
    if (!tablist || !container) return;

    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...container.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const ROTATE_MS = 5000;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const select = (index: number, focus = false) => {
      current = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === index);
      });
      if (focus) tabs[index].focus();
    };

    const pause = () => {
      clearInterval(timer);
      timer = undefined;
    };

    const play = () => {
      if (stopped || timer) return;
      timer = setInterval(() => select((current + 1) % tabs.length), ROTATE_MS);
    };

    // once someone picks a tab themselves, stop rotating for good
    const stop = () => {
      stopped = true;
      pause();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        stop();
        select(i);
      });
      tab.addEventListener('keydown', (e) => {
        const offset = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!offset) return;
        e.preventDefault();
        stop();
        select((i + offset + tabs.length) % tabs.length, true);
      });
    });

    container.addEventListener('mouseenter', pause);
    container.addEventListener('mouseleave', play);
    container.addEventListener('focusin', pause);
    container.addEventListener('focusout', play);

    // only rotate while the section is actually on screen
    const observer = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? play() : pause()),
      { threshold: 0.3 },
    );
    observer.observe(container);

    document.addEventListener(
      'astro:before-swap',
      () => {
        pause();
        observer.disconnect();
      },
      { once: true },
    );
  });
</script>

<style>
  html[class~='dark'] .dark {
    display: block;
  }

  html[class~='dark'] .light {
    display: none;
  }

  .dark {
    display: none;
  }

  .light {
    display: block;
  }
  .container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 160px;
  }

  .text_container {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #909090;
  }

  .description {
    margin: 8px 0 0;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #14151a;
  }

  html[class~='dark'] .description {
    color: #f3f4f6;
  }

  /* the punchline, in the same handwritten face the landing header uses */
  .punchline {
    margin: 10px 0 0;
    font-family: FirstTimeWriting, cursive;
    font-size: 26px;
    line-height: 1;
    color: #909090;
    transform: rotate(-2deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .panel.is-active,
    .underline-inner {
      transition: none;
    }
  }

  .custom-pagination {
    display: flex;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .pagination-item {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 0 2px 10px;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
    color: #909090;
    transition: color 0.2s ease-in-out;
  }

  .pagination-item:hover,
  .pagination-item[aria-selected='true'] {
    color: #14151a;
  }

  html[class~='dark'] .pagination-item:hover,
  html[class~='dark'] .pagination-item[aria-selected='true'] {
    color: #ffffff;
  }

  .icon-flex {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    overflow: hidden;
  }

  .underline-inner {
    height: 100%;
    width: 100%;
    background-color: currentColor;
    transform: scaleX(0);
    transition: transform 0.2s ease-in-out;
  }

  .pagination-item[aria-selected='true'] .underline-inner {
    transform: scaleX(1);
  }

  .panels {
    position: relative;
    aspect-ratio: 3024 / 1898;
  }

  .panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 4px;
    background-color: var(--panel-bg, transparent);
    opacity: 0;
    visibility: hidden;
    /* fade out first, then drop out of the a11y tree and tab order */
    transition:
      opacity 0.4s ease,
      visibility 0s linear 0.4s;
  }

  html[class~='dark'] .panel {
    background-color: var(--panel-bg-dark, transparent);
  }

  .panel.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.4s ease,
      visibility 0s;
  }

  /* deliberately reads as something floating above the app, not part of it */
  .panel__inset {
    position: absolute;
    right: 2%;
    bottom: 4%;
    width: 42%;
    height: auto;
    filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.28))
      drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }

  html[class~='dark'] .panel__inset {
    filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.55))
      drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
  }

  .panel .image {
    flex: 1;
    min-width: 0;
    width: 100%;
    height: 100%;
    background-image: var(--shot-light);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: top center;
  }

  html[class~='dark'] .panel .image {
    background-image: var(--shot-dark);
  }

  .image_container {
    border-radius: 8px 8px 0 0;
    padding: 4px 4px 0;
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-bottom: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }

  .image {
    border-radius: 4px 4px 0 0;
  }

  .buttons {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 16px;
  }

  .button {
    width: 212px;
    border-radius: 3px;
    color: #282b3b;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    padding: 10px 20px;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(33, 39, 46, 0.12);
    background-color: rgba(240, 241, 242, 0.27);
  }

  .button_accent {
    width: 212px;
    border-radius: 3px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    height: 48px;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border: none;
    background-color: #282b3b;
  }

  html[class~='dark'] .button {
    color: #cccccc;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  html[class~='dark'] .button_accent {
    color: #282828;
    background-color: rgb(226, 232, 240);
  }

  html[class~='dark'] .docs {
    border: 1px solid rgb(64, 64, 64);
    background-color: #282828;
    color: rgb(226, 232, 240);
  }

  html[class~='dark'] .image_container {
    border: 1px solid rgb(64, 64, 64);
    border-bottom: none;
    background-color: #282828;
  }

  @media (max-width: 900px) {
    .title {
      font-size: 14px;
    }
    .description {
      font-size: 22px;
    }
    .punchline {
      font-size: 20px;
    }
  }

  @media (max-width: 599px) {
    .container {
      gap: 20px;
    }

    .buttons {
      gap: 10px;
    }

    .button,
    .button_accent {
      font-size: 14px;
      height: 46px;
    }

    .gradient_container {
      padding: 0 12px;
    }

    .gradient_container::after {
      left: -12px;
      width: calc(100% + 24px);
      bottom: -100px;
      height: 200px;
    }
  }
</style>
