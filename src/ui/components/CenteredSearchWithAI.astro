---
import { getCollection } from "astro:content";

import "./docsearch.css";

import {
  defaultDocsDialect,
  dialectRelatedFolder,
  docsDialectIds,
  isDocsDialectId,
  resolveDocsDialectFromSlug,
  type DocsDialectId,
} from "@/dialect-docs";
import cockroachMeta from "@/content/docs/cockroach/_meta.json";
import mssqlMeta from "@/content/docs/mssql/_meta.json";
import mysqlMeta from "@/content/docs/mysql/_meta.json";
import pgMeta from "@/content/docs/pg/_meta.json";
import singlestoreMeta from "@/content/docs/singlestore/_meta.json";
import sqliteMeta from "@/content/docs/sqlite/_meta.json";

const allDocsEntries = await getCollection("docs");
const docsEntrySlugs = new Set<string>(
  allDocsEntries.map((entry) => entry.slug),
);
const metaByDialect = {
  pg: pgMeta,
  mysql: mysqlMeta,
  sqlite: sqliteMeta,
  singlestore: singlestoreMeta,
  mssql: mssqlMeta,
  cockroach: cockroachMeta,
} satisfies Record<DocsDialectId, Array<string | string[]>>;

const getMetaSlugs = (items: Array<string | string[]>): string[] =>
  items.flatMap((item) => (Array.isArray(item) ? [`${item[0]}`] : []));

const metaSlugsByDialect = Object.fromEntries(
  docsDialectIds.map((dialectId) => [
    dialectId,
    getMetaSlugs(metaByDialect[dialectId]),
  ]),
) as Record<DocsDialectId, string[]>;
const docSearchScopeSets = Object.fromEntries(
  docsDialectIds.map((dialectId) => [dialectId, new Set<string>()]),
) as Record<DocsDialectId, Set<string>>;

const addDocSearchPath = (dialectId: DocsDialectId, path: string) => {
  docSearchScopeSets[dialectId].add(path.replace(/\/$/, ""));
};
const getRoutePrefix = (dialectId: DocsDialectId) =>
  dialectId === defaultDocsDialect ? "/docs" : `/docs/${dialectId}`;
const getRootDocsPathDialect = (slug: string): DocsDialectId | null => {
  if (slug.startsWith("get-started/")) {
    return resolveDocsDialectFromSlug(`docs/${slug}`);
  }

  const [folder, page] = slug.split("/");
  if (folder === "column-types" && isDocsDialectId(page)) {
    return page;
  }

  return null;
};

docsDialectIds.forEach((dialectId) => {
  const routePrefix = getRoutePrefix(dialectId);
  metaSlugsByDialect[dialectId].forEach((slug) =>
    addDocSearchPath(dialectId, `${routePrefix}/${slug}`),
  );
});

allDocsEntries.forEach((entry) => {
  const [maybeDialect, ...slugParts] = entry.slug.split("/");

  if (isDocsDialectId(maybeDialect) && slugParts.length > 0) {
    addDocSearchPath(
      maybeDialect,
      `${getRoutePrefix(maybeDialect)}/${slugParts.join("/")}`,
    );
    return;
  }

  const rootPath = `/docs/${entry.slug}`;
  const rootPathDialect = getRootDocsPathDialect(entry.slug);
  if (rootPathDialect) {
    addDocSearchPath(rootPathDialect, rootPath);
    return;
  }

  if (docsEntrySlugs.has(`${defaultDocsDialect}/${entry.slug}`)) {
    addDocSearchPath(defaultDocsDialect, rootPath);
    return;
  }

  docsDialectIds.forEach((dialectId) => addDocSearchPath(dialectId, rootPath));
});

dialectRelatedFolder.forEach((folder) => {
  const folderEntries = allDocsEntries.filter((entry) =>
    entry.slug.startsWith(`${folder}/`),
  );

  docsDialectIds.forEach((dialectId) => {
    if (!metaSlugsByDialect[dialectId].includes(folder)) {
      return;
    }

    const routePrefix = getRoutePrefix(dialectId);
    folderEntries.forEach((entry) =>
      addDocSearchPath(dialectId, `${routePrefix}/${entry.slug}`),
    );
  });
});

const docSearchScopes = Object.fromEntries(
  docsDialectIds.map((dialectId) => [
    dialectId,
    Array.from(docSearchScopeSets[dialectId]).sort(),
  ]),
) as Record<DocsDialectId, string[]>;
---

<div class="nav_search-wrap">
  <div class="search-wrap--centered" id="docsearch"></div>
</div>
<script
  type="module"
  is:inline
  data-astro-rerun
  define:vars={{
    defaultDocSearchDialect: defaultDocsDialect,
    docSearchDialectIds: docsDialectIds,
    docSearchScopes,
  }}
>
  // @ts-ignore Astro injects these values from define:vars.
  const currentDocSearchDialectIds = docSearchDialectIds;
  // @ts-ignore Astro injects these values from define:vars.
  const currentDefaultDocSearchDialect = defaultDocSearchDialect;
  // @ts-ignore Astro injects these values from define:vars.
  const currentDocSearchScopes = docSearchScopes;
  const docSearchDialectSet = new Set(currentDocSearchDialectIds);
  const docSearchScopeSets = Object.fromEntries(
    Object.entries(currentDocSearchScopes).map(([dialectId, paths]) => [
      dialectId,
      new Set(paths),
    ]),
  );
  const getDocSearchDialect = () => {
    const [, section, maybeDialect] = window.location.pathname.split("/");

    if (section !== "docs") {
      return null;
    }

    return docSearchDialectSet.has(maybeDialect)
      ? maybeDialect
      : currentDefaultDocSearchDialect;
  };
  const getDocSearchPath = (value) => {
    if (!value) {
      return "";
    }

    try {
      return new URL(value, window.location.origin).pathname.replace(/\/$/, "");
    } catch {
      return "";
    }
  };
  const isDocSearchHitInScope = (hit) => {
    const dialectId = getDocSearchDialect();
    const scope = dialectId ? docSearchScopeSets[dialectId] : null;

    if (!scope) {
      return true;
    }

    const hitPath = getDocSearchPath(hit?.url || hit?.url_without_anchor);
    return hitPath ? scope.has(hitPath) : true;
  };
  const getSearchParams = (params) => {
    const searchParams = new URLSearchParams(
      typeof params === "string" || params instanceof URLSearchParams
        ? params
        : undefined,
    );

    if (!params) {
      return searchParams;
    }

    if (typeof params !== "string" && !(params instanceof URLSearchParams)) {
      Object.entries(params).forEach(([key, value]) => {
        if (value === undefined || value === null) {
          return;
        }

        searchParams.set(
          key,
          typeof value === "object" ? JSON.stringify(value) : String(value),
        );
      });
    }

    return searchParams;
  };
  const getSearchParamValue = (params, key) => {
    return getSearchParams(params).get(key);
  };
  const getHitsPerPage = (params, fallback = 20) => {
    const hitsPerPage = Number(getSearchParamValue(params, "hitsPerPage"));
    return Number.isFinite(hitsPerPage) && hitsPerPage > 0
      ? hitsPerPage
      : fallback;
  };
  const setHitsPerPage = (params, hitsPerPage) => {
    const searchParams = getSearchParams(params);
    searchParams.set("hitsPerPage", String(hitsPerPage));
    return searchParams.toString();
  };
  const getSearchRequests = (requests) => {
    if (Array.isArray(requests)) {
      return requests;
    }

    if (Array.isArray(requests?.requests)) {
      return requests.requests;
    }

    return null;
  };
  const setSearchRequests = (requests, searchRequests) =>
    Array.isArray(requests)
      ? searchRequests
      : { ...requests, requests: searchRequests };

  docsearch({
    container: '#docsearch',
    appId: "MXZNUT59HV",
    apiKey: "7c390e262ac8858df0b6624d01d9dfef",
    indexName: "orm-drizzle",
    placeholder: "Search documentation...",
    translations: {
      modal: {
        searchBox: {
          cancelButtonText: "Esc",
          cancelButtonAriaLabel: "Close search",
        },
      },
    },
    transformSearchClient(searchClient) {
      return {
        ...searchClient,
        search(requests) {
          const dialectId = getDocSearchDialect();
          const searchRequests = getSearchRequests(requests);

          if (
            !dialectId ||
            !docSearchScopeSets[dialectId] ||
            !searchRequests
          ) {
            return searchClient.search(requests);
          }

          const requestedHitsPerPage = searchRequests.map((request) =>
            getHitsPerPage(request.params),
          );
          const scopedRequests = searchRequests.map((request, index) => ({
            ...request,
            params: setHitsPerPage(
              request.params,
              Math.max(requestedHitsPerPage[index] * 6, 60),
            ),
          }));

          return searchClient
            .search(setSearchRequests(requests, scopedRequests))
            .then((response) => ({
              ...response,
              results: response.results.map((result, index) => {
                if (!Array.isArray(result.hits)) {
                  return result;
                }

                const hitsPerPage = requestedHitsPerPage[index] ||
                  result.hitsPerPage ||
                  20;
                const hits = result.hits
                  .filter(isDocSearchHitInScope)
                  .slice(0, hitsPerPage);

                return {
                  ...result,
                  hits,
                  hitsPerPage,
                  nbHits: hits.length,
                  nbPages: hits.length > 0 ? 1 : 0,
                };
              }),
            }));
        },
      };
    },
    transformItems(items) {
      return items.filter(isDocSearchHitInScope);
    },
  });

  let themeName = localStorage.getItem('theme');
  if(themeName === 'system') {
    themeName = window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  }
</script>
<script>
  /** Activate the mobile keyboard during the tap, before DocSearch renders asynchronously. */
  function initializeMobileSearchFocus(): () => void {
    if (!document.querySelector(".nav_search-wrap")) {
      return () => {};
    }

    const media = window.matchMedia("(max-width: 768px) and (pointer: coarse)");
    let keyboardInput: HTMLInputElement | null = null;
    let inputObserver: MutationObserver | null = null;

    function releaseKeyboardInput() {
      inputObserver?.disconnect();
      inputObserver = null;
      keyboardInput?.remove();
      keyboardInput = null;
      document.removeEventListener("focusin", handleSearchFocus);
    }

    function focusMountedSearchInput() {
      const searchInput = document.querySelector<HTMLInputElement>("#docsearch-input");

      if (searchInput) {
        // Transfer before DocSearch's deferred autofocus can lose the iOS keyboard session.
        searchInput.focus({ preventScroll: true });
      }
    }

    function handleSearchFocus(event: FocusEvent) {
      if (
        event.target instanceof HTMLInputElement &&
        event.target.id === "docsearch-input"
      ) {
        releaseKeyboardInput();
      }
    }

    function handleSearchTap(event: MouseEvent) {
      if (
        !media.matches ||
        !(event.target instanceof Element) ||
        !event.target.closest("#docsearch .DocSearch-Button")
      ) {
        return;
      }

      const searchInput =
        document.querySelector<HTMLInputElement>("#docsearch-input");

      if (searchInput) {
        searchInput.focus({ preventScroll: true });
        return;
      }

      releaseKeyboardInput();
      keyboardInput = document.createElement("input");
      keyboardInput.type = "search";
      keyboardInput.className = "mobile-search-keyboard-input";
      keyboardInput.tabIndex = -1;
      keyboardInput.setAttribute("aria-label", "Search documentation");
      keyboardInput.setAttribute("autocomplete", "off");
      document.body.append(keyboardInput);
      document.addEventListener("focusin", handleSearchFocus);
      keyboardInput.focus({ preventScroll: true });
      inputObserver = new MutationObserver(focusMountedSearchInput);
      inputObserver.observe(document.body, { childList: true, subtree: true });
    }

    document.addEventListener("click", handleSearchTap, true);

    return () => {
      document.removeEventListener("click", handleSearchTap, true);
      releaseKeyboardInput();
    };
  }

  let dispose: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    dispose?.();
    dispose = initializeMobileSearchFocus();
  });
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>
<style>
  :global(.mobile-search-keyboard-input) {
    position: fixed;
    top: 20px;
    left: 20px;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    opacity: 0;
    font-size: 16px;
    pointer-events: none;
  }

  .nav_search-wrap {
    align-items: center;
    display: flex;
    flex-grow: 1;
    gap: 12px;
    max-width: 420px;
  }

  @media screen and (max-width: 768px) {
    .nav_search-wrap {
      display: flex;
      flex: 0 0 44px;
      width: 44px;
      max-width: 44px;
    }

    .search-wrap--centered {
      width: 44px;
    }

    .nav_search-wrap :global(.DocSearch-Button) {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      margin: 0;
      opacity: 1;
      background: transparent !important;
      border-radius: 6px;
      box-shadow: none;
    }

    .nav_search-wrap :global(.DocSearch-Button-Placeholder),
    .nav_search-wrap :global(.DocSearch-Button-Keys) {
      display: none;
    }

    .nav_search-wrap :global(.DocSearch-Search-Icon) {
      width: 20px;
      height: 20px;
    }
  }
</style>
