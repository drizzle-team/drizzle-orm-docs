---
import { siteNavigation } from "@/data/site-navigation";

const pathname = Astro.url.pathname;
const activeHref = pathname === "/latest-releases" || pathname.startsWith("/latest-releases/")
  ? "/latest-releases"
  : pathname.startsWith("/docs/")
  ? "/docs/overview"
  : siteNavigation.find(({ href }) =>
      pathname.startsWith(href.replace("/overview", "")),
    )?.href;
---

<nav class="landing-navbar__wrap" aria-label="Main navigation">
  <div class="landing-navbar__wrap_buttons">
    {siteNavigation.map(({ label, href }) => (
      <a href={href} class="landing-navbar__wrap_button" aria-current={href === activeHref ? "page" : undefined}>{label}</a>
    ))}
  </div>
</nav>
<style>
  .landing-navbar__wrap {
    align-items: center;
    justify-content: center;
    display: flex;
    flex: 0 0 auto;
    width: max-content;
  }

  html.dark .landing-navbar__wrap_buttons {
    background-color: #111;
    border: 1px solid #ffffff14;
  }

  .landing-navbar__wrap_buttons {
    display: flex;
    border-radius: 40px;
    padding: 4px;
    background-color: #fff;
    border: 1px solid #00000014;
  }

  html.dark .landing-navbar__wrap_button {
    color: #e1e3e6;
  }

  .landing-navbar__wrap_button {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 10px;
    color: #4b5563;
    transition: all .2s ease;
    border-radius: 20px;
    line-height: normal;
  }

  html.dark .landing-navbar__wrap_button:hover {
    color: #fff;
  }

  .landing-navbar__wrap_button:hover {
    color: #000;
  }

  .landing-navbar__wrap_button[aria-current="page"] {
    color: #111827;
    background: #f3f4f6;
  }

  html.dark .landing-navbar__wrap_button[aria-current="page"] {
    color: #fff;
    background: #282828;
  }

  .landing-navbar__wrap_button:focus-visible {
    outline-color: #3e7ff0;
  }

  @media screen and (max-width: 836px){
    .landing-navbar__wrap {
      display: none;
    }    
  }
</style>