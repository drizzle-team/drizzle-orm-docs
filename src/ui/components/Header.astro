---
import CenteredSearchWithAI from "./CenteredSearchWithAI.astro";
import NavigationAstro from "./NavigationAstro.astro";
import DialectSwitcher from "@mdx/dialect-switcher/DialectSwitcher.astro";

interface Props {
  slug?: string;
}

const { slug = "" } = Astro.props;
---

<NavigationAstro variant="docs">
  <div slot="context" class="docs-header-database">
    <DialectSwitcher slug={slug} />
  </div>
  <CenteredSearchWithAI slot="search" />
</NavigationAstro>

<style>
  .docs-header-database {
    padding-inline-start: 16px;
    border-inline-start: 1px solid #00000014;
  }

  html.dark .docs-header-database {
    border-color: #303030;
  }

  .docs-header-database :global(.db-switcher) {
    height: 36px;
    border-radius: 8px;
  }

  .docs-header-database :global(.db-switcher:focus-within) {
    outline: 2px solid #3e7ff0;
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .docs-header-database {
      display: none;
    }
  }
</style>
